APP_NAME=ModelOps AI
APP_ENV=production
APP_DEBUG=false
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
SSH_CONNECT_TIMEOUT_SECONDS=15

# Required for public deployments. Send this value in the X-API-Key header.
MODEL_OPS_API_KEY=replace-with-a-long-random-secret

# Optional second gate for remote SSH execution.
EXECUTION_APPROVAL_TOKEN=replace-with-a-separate-approval-secret
DATABASE_PATH=/app/data/modelops.db
